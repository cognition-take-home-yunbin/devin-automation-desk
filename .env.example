# Devin Repair Desk — configuration contract (tutorial §10.4).
# Copy to .env. Simulation mode needs no secrets; live mode is rejected
# unless every required variable is present and non-placeholder.

# --- core -------------------------------------------------------------------
# Required. One of: simulation | live. Unknown or missing = fail closed.
APP_MODE=simulation

# Compose project separates sim/live volumes: repairdesk-sim | repairdesk-live
COMPOSE_PROJECT_NAME=repairdesk-sim

# SQLite database file. Each mode should use its own volume/file.
DATABASE_PATH=/data/repairdesk.sqlite

# --- github (repair target) -------------------------------------------------
GITHUB_REPO=YOUR_GITHUB_NAME/superset-demo
GITHUB_BASE_BRANCH=master
# Live only — a repo-scoped token. Never commit real values.
GITHUB_TOKEN=

# Comma-separated GitHub logins allowed to authorize repairs.
GITHUB_ALLOWED_APPROVERS=

# Intake labels: candidate discovery label and maintainer approval label.
CANDIDATE_ISSUE_LABEL=devin-candidate
APPROVAL_ISSUE_LABEL=devin-approved

SCAN_INTERVAL_SECONDS=60

# --- verification policy ----------------------------------------------------
VERIFICATION_POLICY_PATH=/app/config/verification.yaml

# --- devin (live only) ------------------------------------------------------
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_REPO_REF=
DEVIN_REMEDIATION_PLAYBOOK_ID=
# Comma-separated knowledge IDs.
DEVIN_KNOWLEDGE_IDS=

# --- bounds ------------------------------------------------------------------
MAX_ACTIVE_SESSIONS=1
REPAIR_ACU_LIMIT=20
DAILY_ADMISSION_ACU_LIMIT=60
PROJECT_ADMISSION_ACU_LIMIT=180
POLL_INTERVAL_SECONDS=15
# Pause new dispatch on the very first start of a fresh deployment.
DISPATCH_PAUSED_ON_FIRST_START=true

# --- reporting ---------------------------------------------------------------
REPORT_GITHUB_REPO=
REPORT_DATA_ISSUE_NUMBER=
REPORT_GITHUB_TOKEN=
REPORT_TIMEZONE=Asia/Singapore
REPORT_PUBLISH_INTERVAL_SECONDS=300
REPORT_STALE_AFTER_SECONDS=900
NATIVE_REPORT_SESSION_TAG=repairdesk-native-report
