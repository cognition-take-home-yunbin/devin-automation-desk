# Test image: backend tests + frontend typecheck + production build.
# Runs against an isolated DATABASE_PATH (see compose.yaml).
FROM python:3.12-slim AS backend
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

# Node for the frontend checks.
RUN apt-get update \
 && apt-get install -y --no-install-recommends nodejs npm ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

COPY app/ ./app/
COPY config/ ./config/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY frontend/ ./frontend/

# Pre-install frontend deps so the test run is deterministic and offline.
WORKDIR /app/frontend
RUN npm ci --no-audit --no-fund
WORKDIR /app

CMD ["bash", "scripts/test.sh"]
